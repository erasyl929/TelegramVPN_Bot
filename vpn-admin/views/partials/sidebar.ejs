<aside class="w-64 bg-gray-900 min-h-screen flex flex-col fixed left-0 top-0">
  <div class="p-6 border-b border-gray-700">
    <h1 class="text-white text-xl font-bold">⚡ VPN Admin</h1>
    <p class="text-gray-400 text-sm mt-1">Панель управления</p>
  </div>
  <nav class="flex-1 p-4 space-y-1">
    <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition <%= locals.page === 'dashboard' ? 'bg-gray-800 text-white' : '' %>">
      <span>📊</span> Дашборд
    </a>
    <a href="/users" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition <%= locals.page === 'users' ? 'bg-gray-800 text-white' : '' %>">
      <span>👥</span> Пользователи
    </a>
    <a href="/settings" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition <%= locals.page === 'settings' ? 'bg-gray-800 text-white' : '' %>">
      <span>⚙️</span> Настройки
    </a>
  </nav>
  <div class="p-4 border-t border-gray-700">
    <form action="/logout" method="POST">
      <button class="w-full px-4 py-2 text-gray-400 hover:text-red-400 text-sm transition">
        🚪 Выйти
      </button>
    </form>
  </div>
</aside>